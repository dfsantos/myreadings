#!/usr/bin/env sh
# Valida que a primeira linha da mensagem de commit segue Conventional
# Commits, conforme .claude/rules/commit-conventions.md.
# Instalado automaticamente via core.hooksPath (ver settings.gradle).

commit_msg_file="$1"
first_line=$(head -n 1 "$commit_msg_file")

# Exceções: merge commits e o commit de revert automático do git (começa
# com "Revert \"", não com o tipo "revert:" minúsculo que exigimos).
case "$first_line" in
  "Merge "*|"Revert \""*)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9/_-]+\))?!?: .{1,100}$'

if ! printf '%s' "$first_line" | grep -qE "$pattern"; then
  echo "Commit rejeitado: a mensagem não segue Conventional Commits." >&2
  echo "" >&2
  echo "Formato esperado: <tipo>(<escopo opcional>): <descricao>" >&2
  echo "Tipos validos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  echo "" >&2
  echo "Mensagem recebida:" >&2
  echo "  $first_line" >&2
  echo "" >&2
  echo "Veja .claude/rules/commit-conventions.md para detalhes e exemplos." >&2
  exit 1
fi

exit 0
